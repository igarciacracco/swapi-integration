# Copy to .env. The demo credentials below are for local use only, not a real
# deployment. .env itself is gitignored.

# Signing key for the JWTs this service issues and verifies.
# At least 32 bytes. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# The demo user, stored only as a BCrypt hash (note the {bcrypt} prefix: a
# DelegatingPasswordEncoder reads it, so the scheme can be upgraded later).
# This hash is for the password demo-password-2026. Keep the single quotes:
# unquoted, `source .env` expands $2a and $10 and corrupts the hash.
# To use another password, see "Run it in two minutes" in the README.
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH='{bcrypt}$2a$10$.7J2clSyyeZWzuwz/N/8hOkhVu5c4eWsIi8AEGRs6DpffTaXIbbOK'

# Optional: the port the host injects. Defaults to 8080.
# PORT=8080

# --- Registration (optional; only with --spring.profiles.active=postgres) ---
# The core catalog API needs none of this. Only account creation does, because
# user accounts are the one thing this service owns rather than proxies.
# `docker compose up -d` starts a local Postgres matching these defaults.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/swapi
# SPRING_DATASOURCE_USERNAME=swapi
# SPRING_DATASOURCE_PASSWORD=swapi
